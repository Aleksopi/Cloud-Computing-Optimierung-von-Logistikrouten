# Environment (secrets — only .env.example is tracked)
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node
node_modules/
frontend/dist/
docs/build/node_modules/
docs/build/package-lock.json

# Generated doc/preview artifacts (the .docx/.pptx ARE tracked)
docs/*.pdf
docs/build/preview/

# OS / Office lock files
.DS_Store
~$*

# Docker volumes (not tracked)
postgres_data/

# OSRM data (large binary files — check in manually if desired)
osrm/data/*.osrm
osrm/data/*.osrm.*
osrm/data/*.osm.pbf

# Backend data (keep geojson but not large binaries)
# backend/data/*.geojson  ← these ARE tracked

# Old workspace
workspace/

# User-specific Claude config
.claude/

# Generated outputs — slide decks in outputs/ ARE tracked (only copies)

# Documentation files
docs/
