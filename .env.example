# Copy to .env and adjust values
DATABASE_URL=postgresql://pharma:pharma@postgres:5432/pharma
REDIS_URL=redis://redis:6379/0
OSRM_URL=http://osrm:5000

# HQ position (default: Bern)
HQ_LAT=46.9480
HQ_LON=7.4474
HQ_NAME=HQ_Bern

DATA_DIR=/app/data

# TomTom Traffic API key (optional). If set here it takes precedence over a key
# entered via the website. Leave empty to use the website key / simulation.
TOMTOM_API_KEY=
